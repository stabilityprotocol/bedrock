[Unit]
Description=Bedrock video hasher
After=network.target

[Service]
ExecStart=/usr/bin/python3 -u /home/bedrock/video-hasher/main.py
WorkingDirectory=/home/bedrock/video-hasher
Restart=on-failure
KillMode=control-group
TimeoutStopSec=10
User=bedrock
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
